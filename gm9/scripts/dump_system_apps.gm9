# dump_system_apps.gm9
# SPDX-License-Identifier: GPL-3.0-or-later
# Generated by tools/gen_dump_script.py: edit that, then regenerate.
#
# Copies the .app files of the Japanese HOME Menu and System Settings from
# SysNAND to 0:/gm9/out/3ds-jpn-english/<titleid>/ and decrypts the copies
# there.
# Read-only on system memory: it only reads from 1:/title and only writes
# to the SD card. Only .app files are copied (no .tmd or cmd folder).
#
# Each file is copied as <name>.app.part, decrypted, then renamed to
# <name>.app, so a file named .app is always complete and decrypted.
# If earlier dumps exist, you're asked once whether to redo them or skip
# finished ones. An app counts as finished only if every .app the console
# currently has for it is present, so interrupted dumps, deleted files and
# newer versions after a system update are always redone.
# At the end, it lists which apps were copied fresh, kept from an
# earlier run, or not installed.

set DST 0:/gm9/out/3ds-jpn-english
set NONE 0:/gm9/out/3ds-jpn-english/__nothing__
set ABSENT ""
set NEW ""
set KEPT ""
set MODE redo
set ERRORMSG "Script stopped. Nothing on the\nconsole was changed. Note the\nfile shown and open an issue\non GitHub."

ask "Copy and decrypt 2 system apps\nto 0:/gm9/out/3ds-jpn-english?\n \nThis only reads system memory."
if find $[DST]/* NULL
if ask "Files from an earlier run are\nalready in gm9/out/3ds-jpn-english.\n \nDump those apps again?\n \nYes: replace them with fresh copies.\nNo: keep them and skip them."
set MODE redo
else
set MODE skip
end
end
mkdir -o -s $[DST]


# 1. HOME Menu
set DO 1
set WORK $[NONE]
set CHECK $[NONE]
if chk $[MODE] "skip"
if find $[DST]/0004003000008202 NULL
if find 1:/title/00040030/00008202/content NULL
set DO 0
set CHECK 1:/title/00040030/00008202/content
end
end
end
for -o -s $[CHECK] *.app
    strsplit APPNAME $[FORPATH] "/"
    if not find $[DST]/0004003000008202/$[APPNAME] NULL
    set DO 1
    end
next
if chk $[DO] "0"
set KEPT "$[KEPT]\nHOME Menu"
set PREVIEW_MODE "Dumping system apps\n \n[#.]\n1 of 2\n \nAlready done, skipping:\nHOME Menu"
end
if chk $[DO] "1"
if find 1:/title/00040030/00008202/content NULL
if find $[DST]/0004003000008202 NULL
set PREVIEW_MODE "Dumping system apps\n \n[#.]\n1 of 2\n \nClearing old copy (SD card only):\nHOME Menu"
rm -o -s $[DST]/0004003000008202
end
set PREVIEW_MODE "Dumping system apps\n \n[#.]\n1 of 2\n \nCopying and decrypting:\nHOME Menu"
set WORK 1:/title/00040030/00008202/content
else
set ABSENT "$[ABSENT]\nHOME Menu"
set DO 0
end
end
for -o -s $[WORK] *.app
    strsplit APPNAME $[FORPATH] "/"
    cp -s -w $[FORPATH] $[DST]/0004003000008202/$[APPNAME].part
    decrypt $[DST]/0004003000008202/$[APPNAME].part
    mv -w $[DST]/0004003000008202/$[APPNAME].part $[DST]/0004003000008202/$[APPNAME]
next
if chk $[DO] "1"
set NEW "$[NEW]\nHOME Menu"
end

# 2. System Settings
set DO 1
set WORK $[NONE]
set CHECK $[NONE]
if chk $[MODE] "skip"
if find $[DST]/0004001000020000 NULL
if find 1:/title/00040010/00020000/content NULL
set DO 0
set CHECK 1:/title/00040010/00020000/content
end
end
end
for -o -s $[CHECK] *.app
    strsplit APPNAME $[FORPATH] "/"
    if not find $[DST]/0004001000020000/$[APPNAME] NULL
    set DO 1
    end
next
if chk $[DO] "0"
set KEPT "$[KEPT]\nSystem Settings"
set PREVIEW_MODE "Dumping system apps\n \n[##]\n2 of 2\n \nAlready done, skipping:\nSystem Settings"
end
if chk $[DO] "1"
if find 1:/title/00040010/00020000/content NULL
if find $[DST]/0004001000020000 NULL
set PREVIEW_MODE "Dumping system apps\n \n[##]\n2 of 2\n \nClearing old copy (SD card only):\nSystem Settings"
rm -o -s $[DST]/0004001000020000
end
set PREVIEW_MODE "Dumping system apps\n \n[##]\n2 of 2\n \nCopying and decrypting:\nSystem Settings"
set WORK 1:/title/00040010/00020000/content
else
set ABSENT "$[ABSENT]\nSystem Settings"
set DO 0
end
end
for -o -s $[WORK] *.app
    strsplit APPNAME $[FORPATH] "/"
    cp -s -w $[FORPATH] $[DST]/0004001000020000/$[APPNAME].part
    decrypt $[DST]/0004001000020000/$[APPNAME].part
    mv -w $[DST]/0004001000020000/$[APPNAME].part $[DST]/0004001000020000/$[APPNAME]
next
if chk $[DO] "1"
set NEW "$[NEW]\nSystem Settings"
end

set PREVIEW_MODE "Dumping system apps\n \n[##]\n2 of 2\n \nAll done.\nSummary on the bottom screen."
if chk -u "$[NEW]" ""
echo "Copied and decrypted fresh:\n$[NEW]"
end
if chk -u "$[KEPT]" ""
echo "Already done, kept from earlier:\n$[KEPT]"
end
if chk -u "$[ABSENT]" ""
echo "Not installed on this console:\n$[ABSENT]"
end
set SUCCESSMSG "Done. Decrypted files are in\n0:/gm9/out/3ds-jpn-english"
