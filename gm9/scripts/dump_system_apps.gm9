end
for -o -s $[WORK] *.app
    strsplit APPNAME $[FORPATH] "/"
    cp -s -w $[FORPATH] $[DST]/0004001000020700/$[APPNAME].part
    decrypt $[DST]/0004001000020700/$[APPNAME].part
