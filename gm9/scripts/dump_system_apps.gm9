end
if chk $[DO] "1"
if find 1:/title/00040010/00020700/content NULL
if find $[DST]/0004001000020700 NULL
set PREVIEW_MODE "Dumping system apps\n \n[###....]\n3 of 7\n \nClearing old copy (SD card only):\nMii Maker"
rm -o -s $[DST]/0004001000020700
end
set PREVIEW_MODE "Dumping system apps\n \n[###....]\n3 of 7\n \nCopying and decrypting:\nMii Maker"
set WORK 1:/title/00040010/00020700/content
else
set ABSENT "$[ABSENT]\nMii Maker"
