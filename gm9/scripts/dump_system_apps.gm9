end
if chk $[DO] "1"
if find 1:/title/00040030/00008702/content NULL
if find $[DST]/0004003000008702 NULL
set PREVIEW_MODE "Dumping system apps\n \n[####...]\n4 of 7\n \nClearing old copy (SD card only):\nGame Notes"
rm -o -s $[DST]/0004003000008702
